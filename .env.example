# Copy to .env and fill in your key.

# ── AI review (Groq) ────────────────────────────────────────────────────
# Optional. Without it the app still works — the deterministic score is
# simply final. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Which model reviews the analysis. Check what your key can use with
#   GET https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-120b

# How far the LLM may move the deterministic score, in points.
MAX_LLM_ADJUSTMENT=15

# ── Optional ────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=10

# Backend URL for a production frontend build. Leave unset in dev:
# vite.config.js already proxies /api to http://localhost:8000
# VITE_API_BASE=https://your-backend.example.com
